{
  "description": "Flow session priming hook for Claude Code and VS Code Agent Plugins.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT:-.}/hooks/session-start.sh\" --harness claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
