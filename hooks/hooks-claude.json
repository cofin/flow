{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "flow-session-start",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/session-start.sh\" 2>/dev/null || node \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/session-start.js\"",
            "timeout": 30,
            "description": "Inject Flow project context into Claude sessions."
          }
        ]
      }
    ]
  }
}
