{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "flow-session-start",
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/tools/priming.py\"",
            "timeout": 30,
            "description": "Inject Flow project context into Claude sessions."
          }
        ]
      }
    ]
  }
}
