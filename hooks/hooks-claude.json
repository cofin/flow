{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "flow-session-start",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/session-start.sh\"",
            "timeout": 30,
            "description": "Inject static Flow routing into Claude sessions."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "name": "flow-git-guardrail",
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/block-dangerous-git.sh\"",
            "timeout": 10,
            "description": "Use the Bash and jq guardrail to block prohibited Git operations."
          }
        ]
      }
    ]
  }
}
