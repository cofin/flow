#!/usr/bin/env bash
# Keep the generated Codex package (plugins/flow/) in sync with its sources.
#
# plugins/flow/ is assembled by tools/sync-codex-package.py from repo-root
# sources (skills/, hooks/, .codex/, .codex-plugin/, commands/). It is
# gitignored — regenerate it locally when a commit touches its sources so the
# working copy never drifts, but never stage it.
#
# Install with: make install-hooks
set -euo pipefail

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if printf '%s\n' "$staged" | grep -Eq '^(skills/|hooks/|\.codex/|\.codex-plugin/|commands/)'; then
    uv run --extra dev tools/sync-codex-package.py >/dev/null
fi
