{
  "name": "flow",
  "version": "0.30.1",
  "description": "Unified toolkit for Context-Driven Development",
  "type": "module",
  "main": ".opencode/plugins/flow.js",
  "exports": {
    ".": "./.opencode/plugins/flow.js",
    "./server": "./.opencode/plugins/flow.js"
  },
  "files": [
    ".opencode/plugins/",
    "agents/",
    "assets/",
    "hooks/",
    "hooks.json",
    "plugin.json",
    "rules/",
    "sidecars/",
    "skills/",
    "templates/",
    "tools/__init__.py",
    "tools/validate.py",
    "tools/worktree_env.py",
    "tools/catalog/",
    "vscode-extension/",
    "workflows/",
    "pyproject.toml",
    "uv.lock",
    "!**/__pycache__/**"
  ],
  "bin": {
    "flow-studio": "./sidecars/studio/server.mjs",
    "flow-studio-vscode": "./vscode-extension/install.mjs"
  },
  "scripts": {
    "studio": "node ./sidecars/studio/server.mjs",
    "install:vscode": "node ./vscode-extension/install.mjs",
    "test": "uv run pytest -q"
  },
  "keywords": [
    "flow",
    "context-driven-development",
    "okf",
    "tdd",
    "ai-agent",
    "workflow"
  ],
  "author": "cofin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofin/flow.git"
  }
}
