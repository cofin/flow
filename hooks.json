{
  "flow-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ./hooks/session-start.sh --harness agy",
        "timeout": 15
      }
    ]
  },
  "flow-pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|delete_file|notebook_edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./hooks/pre-tool-guard.sh --harness agy",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "flow-stop-check": {
    "Stop": [
      {
        "type": "command",
        "command": "sh ./hooks/stop-check.sh --harness agy",
        "timeout": 10
      }
    ]
  }
}
