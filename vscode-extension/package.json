{
  "name": "flow-studio",
  "displayName": "Flow Studio",
  "description": "Editor-native Spec-Driven Development for VS Code, Cursor, Windsurf, and Positron: inline spec review comments synced to /flow:revise, active-flow status bar, Specs & Tasks sidebar, CodeLenses, and optional Studio dashboard.",
  "version": "0.34.0",
  "publisher": "cofin",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#202235",
    "theme": "dark"
  },
  "main": "./extension.cjs",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.agents/setup-state.json",
    "workspaceContains:.agents/bundles/index.md",
    "onView:flowSpecsTree",
    "onCommand:flow.openStudio",
    "onCommand:flow.newSpec",
    "onCommand:flow.syncSpecs",
    "onCommand:flow.searchDocs",
    "onCommand:flow.quickActions"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowStudio",
          "title": "Flow",
          "icon": "logo.svg"
        }
      ]
    },
    "views": {
      "flowStudio": [
        {
          "id": "flowSpecsTree",
          "name": "Specs & Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "flow.openStudio",
        "title": "Flow: Open Studio",
        "category": "Flow",
        "icon": "$(layout-panel)"
      },
      {
        "command": "flow.studioHome",
        "title": "Flow: Studio Home",
        "category": "Flow"
      },
      {
        "command": "flow.newSpec",
        "title": "Flow: New Spec / PRD",
        "category": "Flow",
        "icon": "$(add)"
      },
      {
        "command": "flow.syncSpecs",
        "title": "Flow: Sync Spec Checklists",
        "category": "Flow",
        "icon": "$(sync)"
      },
      {
        "command": "flow.reviseSpec",
        "title": "Flow: Send Review Notes to /flow:revise",
        "category": "Flow",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "flow.searchDocs",
        "title": "Flow: Search Bundle Notes & Specs",
        "category": "Flow",
        "icon": "$(search)"
      },
      {
        "command": "flow.dispatchTask",
        "title": "Flow: Dispatch Prompt to Harness",
        "category": "Flow",
        "icon": "$(play)"
      },
      {
        "command": "flow.runEntrypoint",
        "title": "Flow: Run Detected Python Entrypoint",
        "category": "Flow"
      },
      {
        "command": "flow.selectTargetHarness",
        "title": "Flow: Select Default Target Harness",
        "category": "Flow"
      },
      {
        "command": "flow.quickActions",
        "title": "Flow: Quick Actions",
        "category": "Flow"
      },
      {
        "command": "flow.addSpecComment",
        "title": "Add Review Note",
        "category": "Flow"
      },
      {
        "command": "flow.replySpecComment",
        "title": "Reply",
        "category": "Flow"
      },
      {
        "command": "flow.resolveSpecComment",
        "title": "Resolve Note",
        "category": "Flow",
        "icon": "$(check)"
      },
      {
        "command": "flow.reopenSpecComment",
        "title": "Reopen Note",
        "category": "Flow",
        "icon": "$(issues)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flow.syncSpecs",
          "when": "view == flowSpecsTree",
          "group": "navigation@1"
        },
        {
          "command": "flow.newSpec",
          "when": "view == flowSpecsTree",
          "group": "navigation@2"
        },
        {
          "command": "flow.openStudio",
          "when": "view == flowSpecsTree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "flow.openStudio",
          "when": "view == flowSpecsTree && viewItem == flowSpec",
          "group": "inline@1"
        },
        {
          "command": "flow.dispatchTask",
          "when": "view == flowSpecsTree && (viewItem == flowSpec || viewItem == flowChapter)",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "flow.addSpecComment",
          "when": "commentController == flowSpecReview && commentThreadIsEmpty",
          "group": "inline"
        },
        {
          "command": "flow.replySpecComment",
          "when": "commentController == flowSpecReview && !commentThreadIsEmpty",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "flow.resolveSpecComment",
          "when": "commentController == flowSpecReview && commentThread == flowReviewOpen",
          "group": "inline@1"
        },
        {
          "command": "flow.reopenSpecComment",
          "when": "commentController == flowSpecReview && commentThread == flowReviewResolved",
          "group": "inline@1"
        },
        {
          "command": "flow.reviseSpec",
          "when": "commentController == flowSpecReview",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Flow Studio",
      "properties": {
        "flow.defaultHarness": {
          "type": "string",
          "enum": [
            "copilot",
            "cursor",
            "claude",
            "codex",
            "opencode",
            "agy"
          ],
          "default": "copilot",
          "description": "Default AI agent harness targeted when dispatching Flow commands from VS Code or Cursor."
        },
        "flow.executionMode": {
          "type": "string",
          "enum": [
            "direct-workspace",
            "worktree-isolated",
            "read-only"
          ],
          "default": "direct-workspace",
          "description": "Execution mode when dispatching Flow tasks to external CLI harnesses."
        }
      }
    }
  }
}
