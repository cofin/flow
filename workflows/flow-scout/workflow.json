{
  "name": "flow-scout",
  "description": "Run parallel read-only SubsystemDigest reconnaissance scouts with federated local+sibling search and worker-slice boundary hints.",
  "entry": "workflow.py",
  "args": {
    "type": "object",
    "properties": {
      "subsystems": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "paths": {"type": "array", "items": {"type": "string"}},
            "focus": {"type": "string"},
            "narrow_fetch": {"type": "boolean"}
          },
          "required": ["name", "paths"]
        },
        "description": "Subsystems and repository paths to inspect in parallel."
      },
      "query": {"type": "string", "description": "Optional federated knowledge search query."},
      "planes": {"type": "array", "items": {"type": "string"}, "description": "Search planes (local, siblings)."},
      "harness": {"type": "string", "description": "Active harness identifier."},
      "scout_model": {"type": "string", "description": "Explicit scout model override."},
      "narrow_model": {"type": "string", "description": "Explicit narrow-fetch model override."},
      "scout_agent": {"type": "string", "description": "Custom agent profile for heavy scouts."},
      "narrow_agent": {"type": "string", "description": "Custom agent profile for narrow scouts."},
      "timeout_seconds": {"type": "integer", "description": "Per-scout timeout in seconds."}
    },
    "required": ["subsystems"]
  }
}
